
# ─────────────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────────────
APP_NAME=RepoContext AI
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000

# API key required to call protected endpoints.
# In production (APP_ENV=production), this MUST be set to a strong secret.
API_KEY=change-me

# ─────────────────────────────────────────────────────
# Chat model provider: openai | ollama
# ─────────────────────────────────────────────────────
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5-coder:7b
LLM_TEMPERATURE=0

# Optional fallback model (activated on primary failure).
# Leave blank to disable fallback. Setting FALLBACK_PROVIDER=openai
# requires OPENAI_API_KEY to be configured.
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_MODEL=

# ─────────────────────────────────────────────────────
# OpenAI (only required when LLM_PROVIDER=openai or embedding provider=openai)
# ─────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_BASE_URL=

# ─────────────────────────────────────────────────────
# Ollama server
# ─────────────────────────────────────────────────────
OLLAMA_HOST=localhost
OLLAMA_PORT=11434
OLLAMA_CHAT_MODEL=qwen2.5-coder:7b
OLLAMA_TIMEOUT=120
OLLAMA_NUM_CTX=8192

# ─────────────────────────────────────────────────────
# Embedding provider: openai | ollama
# ─────────────────────────────────────────────────────
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text

# ─────────────────────────────────────────────────────
# GitHub (optional — only needed for remote repository cloning)
# ─────────────────────────────────────────────────────
GITHUB_TOKEN=
GITHUB_CLONE_TIMEOUT=120
MAX_REPOSITORY_SIZE_MB=500

# ─────────────────────────────────────────────────────
# RAG / Retrieval
# ─────────────────────────────────────────────────────
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
RETRIEVER_TOP_K=5
VECTOR_STORE_PATH=./data/chroma
COLLECTION_NAME=repo_context

# ─────────────────────────────────────────────────────
# Trusted repository registry
# Comma-separated list of  id:path  pairs.
# Example: my-api:/home/user/projects/my-api,frontend:/home/user/projects/ui
# ─────────────────────────────────────────────────────
REPOSITORIES=

# ─────────────────────────────────────────────────────
# Repository cache (local clones stored here)
# ─────────────────────────────────────────────────────
REPOSITORY_CACHE_PATH=./data/repositories

# ─────────────────────────────────────────────────────
# Conversation memory
# ─────────────────────────────────────────────────────
SESSION_TTL_MINUTES=60
CHECKPOINT_DB_PATH=./data/checkpoints.db

# ─────────────────────────────────────────────────────
# LangSmith tracing (optional)
# ─────────────────────────────────────────────────────
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=repo-context-ai
LANGSMITH_ENDPOINT=https://api.smith.langchain.com